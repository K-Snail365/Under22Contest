{
  "name": "GCP Python Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.15.8"
    }
  },
  "containerEnv": {
    "CLOUDSDK_CORE_PROJECT": "u22procon-2026",
    "GOOGLE_CLOUD_PROJECT": "u22procon-2026"
  },
  "mounts": [
    "source=gcloud-config,target=/home/vscode/.config/gcloud,type=volume"
  ],
  "postStartCommand": "sudo mkdir -p /home/vscode/.config/gcloud && sudo chown -R vscode:vscode /home/vscode/.config/gcloud",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "hashicorp.terraform"
      ]
    }
  },
  "remoteUser": "vscode"
}